{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-stage3-p1-harmful-candidate-v1",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {"const": "candidate_prompt_frame"},
    "candidate_only": {"const": true},
    "formal_input": {"const": false},
    "frame_order_rule": {"const": ["selection_rank_sha256_ascending", "source_id_numeric_ascending"]},
    "frame_selection_ranks_sha256": {"$ref": "#/$defs/hash"},
    "frame_sha256": {"$ref": "#/$defs/hash"},
    "frame_source_ids_sha256": {"$ref": "#/$defs/hash"},
    "record_count": {"const": 100},
    "records": {"items": {"$ref": "#/$defs/record"}, "maxItems": 100, "minItems": 100, "type": "array"},
    "schema": {"const": "paper1.stage3.p1_harmful_selection.selected.v1"},
    "selection_namespace": {"const": "paper1-stage3-p1-harmful-selection-v1"},
    "self_sha256": {"$ref": "#/$defs/hash"}
  },
  "required": ["artifact_type", "candidate_only", "formal_input", "frame_order_rule", "frame_selection_ranks_sha256", "frame_sha256", "frame_source_ids_sha256", "record_count", "records", "schema", "selection_namespace", "self_sha256"],
  "type": "object",
  "$defs": {
    "hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "record": {
      "additionalProperties": false,
      "properties": {
        "frame_position": {"maximum": 100, "minimum": 1, "type": "integer"},
        "question": {"minLength": 1, "type": "string"},
        "question_sha256": {"$ref": "#/$defs/hash"},
        "record_identity_sha256": {"$ref": "#/$defs/hash"},
        "replacement_for_source_id": {"type": ["integer", "null"]},
        "risk_area": {"const": "Malicious Uses"},
        "selection_disposition": {"enum": ["provisional_selected", "same_stratum_rank_replacement"]},
        "selection_rank_sha256": {"$ref": "#/$defs/hash"},
        "source_id": {"type": "integer"},
        "specific_harms": {"minLength": 1, "type": "string"},
        "types_of_harm": {"minLength": 1, "type": "string"}
      },
      "required": ["frame_position", "question", "question_sha256", "record_identity_sha256", "replacement_for_source_id", "risk_area", "selection_disposition", "selection_rank_sha256", "source_id", "specific_harms", "types_of_harm"],
      "type": "object"
    }
  }
}
