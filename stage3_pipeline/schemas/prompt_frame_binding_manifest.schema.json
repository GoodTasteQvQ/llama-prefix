{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-stage3-prompt-frame-binding-manifest-v2",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "paper1-stage3-prompt-frame-binding-manifest-v2"},
    "protocol_version": {"const": "v3.5-rc2"},
    "artifact_kind": {"const": "prompt_frame_binding_manifest"},
    "synthetic_fixture": {"type": "boolean"},
    "formal_experiment_run": {"const": false},
    "split_order": {"const": ["p1_harmful", "p1_benign", "behavior_screen", "behavior_confirm", "benign_confirm"]},
    "splits": {"items": {"$ref": "#/$defs/split"}, "maxItems": 5, "minItems": 5, "type": "array"},
    "global_identity_sha256": {"$ref": "#/$defs/hash"},
    "global_deduplication_evidence": {"additionalProperties": false, "properties": {"method": {"const": "frozen-priority-global-dedup-and-leakage-review"}, "exact_overlap_count": {"const": 0}, "semantic_review_status": {"const": "COMPLETE"}, "evidence_path": {"minLength": 1, "type": "string"}, "evidence_schema_version": {"minLength": 1, "type": "string"}, "evidence_sha256": {"$ref": "#/$defs/hash"}}, "required": ["method", "exact_overlap_count", "semantic_review_status", "evidence_path", "evidence_schema_version", "evidence_sha256"], "type": "object"},
    "created_at_utc": {"minLength": 1, "type": "string"},
    "self_sha256": {"$ref": "#/$defs/hash"}
  },
  "required": ["schema_version", "protocol_version", "artifact_kind", "synthetic_fixture", "formal_experiment_run", "split_order", "splits", "global_identity_sha256", "global_deduplication_evidence", "created_at_utc", "self_sha256"],
  "type": "object",
  "$defs": {
    "hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "identity": {"additionalProperties": false, "properties": {"position": {"minimum": 1, "type": "integer"}, "prompt_id": {"minLength": 1, "type": "string"}, "record_identity_sha256": {"$ref": "#/$defs/hash"}, "source_id": {"type": ["integer", "string"]}, "source_row_sha256": {"$ref": "#/$defs/hash"}, "question_sha256": {"$ref": "#/$defs/hash"}, "category_id": {"minLength": 1, "type": "string"}}, "required": ["position", "prompt_id", "record_identity_sha256", "source_id", "source_row_sha256", "question_sha256", "category_id"], "type": "object"},
    "split": {"additionalProperties": false, "properties": {"split_id": {"type": "string"}, "domain": {"enum": ["harmful", "benign"]}, "role": {"type": "string"}, "expected_count": {"type": "integer"}, "source_repository_id": {"minLength": 1, "type": "string"}, "source_channel": {"description": "Non-P1 prompt payloads require local_snapshot; git/huggingface are reserved for the independently fixed P1 candidate and unresolved object_store prompt sources fail closed.", "enum": ["huggingface", "git", "local_snapshot", "object_store"]}, "source_revision": {"minLength": 1, "type": "string"}, "source_revision_evidence": {"oneOf": [{"additionalProperties": false, "properties": {"evidence_type": {"const": "git_commit"}, "commit_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"}}, "required": ["evidence_type", "commit_sha"], "type": "object"}, {"additionalProperties": false, "properties": {"evidence_type": {"const": "directory_manifest_sha256"}, "manifest_sha256": {"$ref": "#/$defs/hash"}}, "required": ["evidence_type", "manifest_sha256"], "type": "object"}, {"additionalProperties": false, "properties": {"evidence_type": {"const": "versioned_object"}, "version_id": {"minLength": 1, "type": "string"}, "etag_sha256": {"$ref": "#/$defs/hash"}}, "required": ["evidence_type", "version_id", "etag_sha256"], "type": "object"}]}, "source_path": {"minLength": 1, "type": "string"}, "upstream_source_path": {"minLength": 1, "type": "string"}, "source_schema_version": {"minLength": 1, "type": "string"}, "source_file_sha256": {"$ref": "#/$defs/hash"}, "source_snapshot_manifest_path": {"minLength": 1, "type": "string"}, "source_snapshot_manifest_sha256": {"$ref": "#/$defs/hash"}, "source_snapshot_manifest_schema_version": {"minLength": 1, "type": "string"}, "license": {"minLength": 1, "type": "string"}, "license_path": {"minLength": 1, "type": "string"}, "license_sha256": {"$ref": "#/$defs/hash"}, "category_registry_path": {"minLength": 1, "type": "string"}, "category_registry_sha256": {"$ref": "#/$defs/hash"}, "category_registry_schema_version": {"minLength": 1, "type": "string"}, "ordered_identities": {"items": {"$ref": "#/$defs/identity"}, "type": "array"}, "frame_sha256": {"$ref": "#/$defs/hash"}, "deduplication_evidence_path": {"minLength": 1, "type": "string"}, "deduplication_evidence_schema_version": {"minLength": 1, "type": "string"}, "deduplication_evidence_sha256": {"$ref": "#/$defs/hash"}, "leakage_evidence_path": {"minLength": 1, "type": "string"}, "leakage_evidence_schema_version": {"minLength": 1, "type": "string"}, "leakage_evidence_sha256": {"$ref": "#/$defs/hash"}}, "required": ["split_id", "domain", "role", "expected_count", "source_repository_id", "source_channel", "source_revision", "source_revision_evidence", "source_path", "upstream_source_path", "source_schema_version", "source_file_sha256", "source_snapshot_manifest_path", "source_snapshot_manifest_sha256", "source_snapshot_manifest_schema_version", "license", "license_path", "license_sha256", "category_registry_path", "category_registry_sha256", "category_registry_schema_version", "ordered_identities", "frame_sha256", "deduplication_evidence_path", "deduplication_evidence_schema_version", "deduplication_evidence_sha256", "leakage_evidence_path", "leakage_evidence_schema_version", "leakage_evidence_sha256"], "type": "object"}
  }
}
