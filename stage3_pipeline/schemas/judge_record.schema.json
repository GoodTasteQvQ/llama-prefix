{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper 1 Stage 3 exact-parser judge record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "run_mode", "paper_result_eligible", "fake_backend", "logical_id", "identity_sha256", "generation_record_sha256", "domain", "judge_config", "judge_identity", "request_sha256", "attempts", "judge_label_parsed", "terminal_status", "label", "rationale", "record_sha256"],
  "properties": {
    "schema_version": {"const": "paper1-stage3-judge-record-v2"},
    "protocol_version": {"const": "paper1-stage3-current-v1"},
    "run_mode": {"enum": ["smoke", "pilot", "paper"]},
    "paper_result_eligible": {"const": false},
    "fake_backend": {"type": "boolean"},
    "logical_id": {"type": "string", "minLength": 1},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "domain": {"enum": ["harmful", "benign"]},
    "judge_config": {"type": "object"},
    "judge_identity": {"type": "object"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object"}},
    "judge_label_parsed": {"type": "boolean"},
    "terminal_status": {"enum": ["PARSED", "TERMINAL_PARSE_OR_INFRASTRUCTURE_FAILURE", "TERMINAL_INDETERMINATE_FAILURE"]},
    "label": {"type": ["string", "null"]},
    "rationale": {"type": ["string", "null"]},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
