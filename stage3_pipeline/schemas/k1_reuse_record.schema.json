{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper 1 Stage 3 K1 exact P2 reuse record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "run_mode", "paper_result_eligible", "fake_backend", "logical_id", "identity_sha256", "source_p2_logical_id", "source_p2_record_sha256", "cell", "prompt_id", "vector_id", "pair_id", "arm", "anchor", "estimator", "label", "retained", "generation_calls_added", "judge_calls_added", "record_sha256"],
  "properties": {
    "schema_version": {"const": "paper1-stage3-k1-reuse-record-v2"},
    "protocol_version": {"const": "paper1-stage3-current-v1"},
    "run_mode": {"enum": ["smoke", "pilot", "paper"]},
    "paper_result_eligible": {"const": false},
    "fake_backend": {"type": "boolean"},
    "logical_id": {"type": "string", "minLength": 1},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_p2_logical_id": {"type": "string", "minLength": 1},
    "source_p2_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cell": {"enum": ["P2_A_all", "P2_A_content", "P2_T_all", "P2_T_content"]},
    "prompt_id": {"type": "string", "minLength": 1},
    "vector_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["all-token", "content-token"]},
    "anchor": {"enum": ["A", "T"]},
    "estimator": {"enum": ["mu_all_tw", "mu_content_tw"]},
    "label": {"enum": ["broken", "unsafe", "refusal", "safe"]},
    "retained": {"const": true},
    "generation_calls_added": {"const": 0},
    "judge_calls_added": {"const": 0},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
