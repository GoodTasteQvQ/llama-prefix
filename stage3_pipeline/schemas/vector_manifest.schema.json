{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper1-stage3-vector-manifest-v1",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "paper1-stage3-vector-manifest-v1"},
    "protocol_version": {"const": "v3.5-rc2"},
    "artifact_kind": {"const": "stage3_vector_manifest"},
    "synthetic_fixture": {"type": "boolean"},
    "formal_experiment_run": {"const": false},
    "checkpoint_attestation_self_sha256": {"$ref": "#/$defs/hash"},
    "seed": {"const": 42},
    "generator": {"type": "object"},
    "hidden_dimension": {"const": 3584},
    "row_count": {"const": 30},
    "tensor_file": {"type": "object"},
    "pool_sha256": {"$ref": "#/$defs/hash"},
    "row_ids": {"maxItems": 30, "minItems": 30, "type": "array", "uniqueItems": true},
    "row_sha256": {"items": {"$ref": "#/$defs/hash"}, "maxItems": 30, "minItems": 30, "type": "array"},
    "normalization": {"type": "object"},
    "partitions": {"type": "object"},
    "created_at_utc": {"minLength": 1, "type": "string"},
    "self_sha256": {"$ref": "#/$defs/hash"}
  },
  "required": ["schema_version", "protocol_version", "artifact_kind", "synthetic_fixture", "formal_experiment_run", "checkpoint_attestation_self_sha256", "seed", "generator", "hidden_dimension", "row_count", "tensor_file", "pool_sha256", "row_ids", "row_sha256", "normalization", "partitions", "created_at_utc", "self_sha256"],
  "type": "object",
  "$defs": {"hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}
}
